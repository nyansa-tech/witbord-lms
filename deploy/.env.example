# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# Domain
CANVAS_DOMAIN=learn.witbord.com

# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_long_random_hex_at_least_40_chars

# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_db_password

# Image tag for local builds
WITBORD_IMAGE_TAG=prod
HOST_USER_ID=1000

# AWS (S3 file storage) — prefer IAM instance role; keys optional if role is attached
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=witbord-files-prod

# SES SMTP (from SES console → SMTP settings)
SES_SMTP_ADDRESS=email-smtp.af-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
EMAIL_DOMAIN=witbord.com
EMAIL_FROM=notifications@witbord.com
EMAIL_DEFAULT_NAME=Witbord

# First admin (used by first_boot.sh)
CANVAS_LMS_ADMIN_EMAIL=admin@witbord.com
CANVAS_LMS_ADMIN_PASSWORD=replace_me_strong_password
CANVAS_LMS_STATS_COLLECTION=opt_out
