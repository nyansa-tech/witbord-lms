<% p = asset.is_a?(Pseudonym) ? asset : asset.pseudonym %>
<% cc = asset.is_a?(CommunicationChannel) ? asset : (p.communication_channel || p.user.communication_channel) %>
<% product_name = p.account.root_account.product_name %>

<% define_content :link do %>
  <%= p.user.registered? ? profile_url : registration_confirmation_url(cc.confirmation_code) %>
<% end %>

<% define_content :subject do %>
  <%= t :subject, "Finish Registration: %{product_name}", product_name: product_name %>
<% end %>

<a href="<%= content(:link) %>">
  <%= t :link, "Click here to finish the registration process" %>
</a>

<p><%= t :body, "You have been registered for a %{product_name} account at %{account}!  Before you can log in and start using %{product_name}, you'll need to finish the configuration process.", :account => p.account.display_name, :product_name => product_name %></p>
