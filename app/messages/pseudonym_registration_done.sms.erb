<% p = asset.is_a?(Pseudonym) ? asset : asset.pseudonym %>
<% product_name = p.account.root_account.product_name %>
<% define_content :link do %>
  <%= profile_url %>
<% end %>

<%= t :body, "You have been registered for a %{product_name} account at %{account}!  ", :account => p.account.display_name, :product_name => product_name %>
